<Window x:Class="NoCloudware.UI.Core.Controls.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        x:Name="AboutDialogWindow"
        mc:Ignorable="d"
        Title="{Binding DialogTitle, RelativeSource={RelativeSource Self}}"
        Width="{Binding DialogWidth, RelativeSource={RelativeSource Self}}" Height="{Binding DialogHeight, RelativeSource={RelativeSource Self}}"
        MinWidth="480" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        KeyDown="OnKeyDown">

    <Grid Margin="20"
          TextOptions.TextFormattingMode="Display"
          TextOptions.TextRenderingMode="ClearType">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo y título -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="64" Height="64"
                    CornerRadius="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    Margin="0,0,15,0">
                <Image x:Name="LogoImage"
                       Width="48" Height="48"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="AppNameTextBlock"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="AppVersionTextBlock"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0"
                               VerticalAlignment="Center"/>
                    <Button x:Name="CheckUpdatesButton"
                            Content="{Binding CheckUpdatesText, RelativeSource={RelativeSource AncestorType=Window}}"
                            Click="CheckUpdatesButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource AccentBrush}"
                            Cursor="Hand"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            FontSize="11"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Separador -->
        <Separator Grid.Row="1"
                   Background="{DynamicResource BorderBrush}"
                   Margin="0,0,0,15"/>

        <!-- Créditos (scrollable) -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,0,15">
            <StackPanel>

                <TextBlock x:Name="CreditsHeaderTextBlock"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14"
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="DevelopedByTextBlock"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>

                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,12">
                    <Hyperlink x:Name="DeveloperHyperlink"
                               RequestNavigate="OnHyperlinkRequestNavigate"/>
                </TextBlock>

                <TextBlock x:Name="ThirdPartyLibrariesTextBlock"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>

                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap">
                    <Hyperlink RequestNavigate="OnHyperlinkRequestNavigate"
                               NavigateUri="https://github.com/yt-dlp/yt-dlp">
                        yt-dlp
                    </Hyperlink>
                    <Run Text=" - "/>
                    <Run x:Name="YtDlpDescTextBlock" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </TextBlock>

                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap">
                    <Hyperlink RequestNavigate="OnHyperlinkRequestNavigate"
                               NavigateUri="https://github.com/lepoco/wpfui">
                        WPF-UI
                    </Hyperlink>
                    <Run Text=" - "/>
                    <Run x:Name="WpfUiDescTextBlock" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </TextBlock>

                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap">
                    <Hyperlink RequestNavigate="OnHyperlinkRequestNavigate"
                               NavigateUri="https://github.com/CommunityToolkit/dotnet">
                        CommunityToolkit.Mvvm
                    </Hyperlink>
                    <Run Text=" - "/>
                    <Run x:Name="MvvmDescTextBlock" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </TextBlock>

                <TextBlock x:Name="SpecialThanksTextBlock"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>

                <TextBlock x:Name="SpecialThanksMessageTextBlock"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="TechnologiesUsedTextBlock"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>

                <TextBlock x:Name="TechListTextBlock"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="LicenseTextBlock"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>

                <TextBlock x:Name="LicenseInfoTextBlock"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,4"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Botón Cerrar -->
        <Button Grid.Row="3"
                Content="{Binding CloseButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                Click="CloseButton_Click"
                HorizontalAlignment="Right"
                Padding="20,8"
                FontSize="12"
                Style="{DynamicResource PrimaryButtonStyle}"/>
    </Grid>
</Window>